# Copy this file to .env and fill in your own values
DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/whistledrop
TEST_DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/whistledrop_test

# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Only people who know this code can create a moderator account
MODERATOR_INVITE_CODE=change-this-invite-code
